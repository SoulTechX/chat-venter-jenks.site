# ── Notificaciones Web Push (VAPID) ─────────────────────────────────────
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_EMAIL=mailto:admin@venterjenks.com.ar

# ── Almacenamiento ────────────────────────────────────────────────────────
UPLOAD_DIR=/uploads/chat
CHAT_HISTORY_DIR=/data/chat
MAX_UPLOAD_SIZE_MB=25
MAX_DAILY_UPLOAD_GB=2
CHAT_RETENTION_DAYS=5

# ── Servidor ─────────────────────────────────────────────────────────────
TZ=America/Argentina/Buenos_Aires
NODE_ENV=production
PORT=3000
